@page "/customers"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject ICustomerService CustomerService

<PageTitle>Müşteriler</PageTitle>

<div class="d-flex align-items-center mb-3">
    <h2 class="mb-0">Müşteri Yönetimi</h2>
    <AuthorizeView Roles="Admin,SalesPerson" Context="a">
        <a href="customers/new" class="btn btn-primary ms-auto">➕ Yeni Müşteri</a>
    </AuthorizeView>
</div>

<div class="card summary-box mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-6">
                <input class="form-control" placeholder="Ara: ad, soyad, telefon, T.C." @bind="filter.Keyword" @bind:event="oninput" @onkeyup="OnKey" />
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="StatusValue" @bind:after="Load" title="Müşterinin en son teklifinin durumu">
                    <option value="">Tüm durumlar</option>
                    @foreach (var s in OfferStatusText.All)
                    {
                        <option value="@((int)s)">@StatusOptionLabel(s)</option>
                    }
                    <option value="@NoOfferValue">Teklifi yok</option>
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-outline-primary w-100" @onclick="Load">Ara</button>
            </div>
        </div>
    </div>
</div>

<div class="card summary-box">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr><th>Ad Soyad</th><th>T.C.</th><th>Telefon</th><th>İl / İlçe</th><th>Son Teklif</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var c in items)
                {
                    <tr>
                        <td>@c.FullName</td>
                        <td>@c.NationalId</td>
                        <td>@c.Phone</td>
                        <td>@c.City / @c.District</td>
                        <td>
                            @if (latestStatus.TryGetValue(c.Id, out var st)) { <StatusBadge Status="st" /> }
                            else { <span class="text-muted small">Teklif yok</span> }
                        </td>
                        <td class="text-end">
                            <a href="customers/@c.Id/tracking" class="btn btn-sm btn-outline-success">📊 Takip</a>
                            <AuthorizeView Roles="Admin,SalesPerson" Context="a">
                                <a href="offers/new?customerId=@c.Id" class="btn btn-sm btn-outline-primary">Teklif</a>
                                <a href="customers/@c.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
                @if (items.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Kayıt bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private CustomerSearchFilter filter = new();
    private List<Customer> items = new();
    private Dictionary<int, OfferStatus> latestStatus = new();

    // Durum açılır menüsü: boş = tümü, sayı = OfferStatus, "none" = hiç teklifi olmayanlar.
    private const string NoOfferValue = "none";
    private string StatusValue
    {
        get => filter.OnlyWithoutOffer ? NoOfferValue
             : filter.LastOfferStatus is { } s ? ((int)s).ToString() : "";
        set
        {
            filter.OnlyWithoutOffer = value == NoOfferValue;
            filter.LastOfferStatus = int.TryParse(value, out var v) ? (OfferStatus)v : null;
        }
    }

    // Teslim butonu teklifi "Tamamlandı" yapar; kullanıcılar bunu "Teslim Edildi" diye arar.
    private static string StatusOptionLabel(OfferStatus s) =>
        s == OfferStatus.Completed ? "Tamamlandı (Teslim Edildi)" : OfferStatusText.Label(s);

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load()
    {
        items = await CustomerService.SearchAsync(filter);
        latestStatus = await CustomerService.GetLatestOfferStatusesAsync(items.Select(c => c.Id));
    }
    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await Load(); }
}
